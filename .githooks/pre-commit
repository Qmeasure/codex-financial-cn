#!/usr/bin/env bash
# 对已暂存变更自动执行 Codex 插件 patch 版本递增，保持相对 main 至少领先一个 patch。
# 每个分支只需要递增一次，不按每个 commit 重复递增。
#
# 单次安装：git config core.hooksPath .githooks
#
# 单次跳过：git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "[pre-commit] 未找到 python3，跳过 version-bump。" >&2
  exit 0
fi

python3 "$REPO_ROOT/scripts/version_bump.py" --apply
